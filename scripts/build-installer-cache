#!/usr/bin/env python3
"""Build the Java 8-compatible cache adapter using an explicitly selected JDK."""
import argparse
from pathlib import Path
import subprocess
import tempfile
import zipfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--javac", required=True)
args = parser.parse_args()
source = root / "crates/block-launcher/assets/installer-cache/InstallerCache.java"
output = source.parent / "installer-cache.jar"
with tempfile.TemporaryDirectory(prefix="block-installer-cache-") as directory:
    classes = Path(directory)
    subprocess.run([args.javac, "--release", "8", "-encoding", "UTF-8", "-d", str(classes), str(source)], check=True)
    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED) as jar:
        entries = {"META-INF/MANIFEST.MF": b"Manifest-Version: 1.0\r\nPremain-Class: me.ztd.block.installer.InstallerCache\r\n\r\n"}
        entries.update({path.relative_to(classes).as_posix(): path.read_bytes() for path in classes.rglob("*.class")})
        for name, data in sorted(entries.items()):
            info = zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o100644 << 16
            jar.writestr(info, data)
print(output)
