#!/usr/bin/env python3
"""Capture disposable, network-free debug scenarios on macOS."""

import argparse
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
SWIFT = r'''
import AppKit
import CoreGraphics
import Foundation
guard CGPreflightScreenCaptureAccess() else {
    fputs("Screen Recording permission is required for native screenshots.\n", stderr)
    exit(3)
}
let pid = pid_t(CommandLine.arguments[1])!
if CommandLine.arguments.count > 2 && CommandLine.arguments[2] == "--terminate" {
    NSRunningApplication(processIdentifier: pid)?.terminate()
    exit(0)
}
// Floating panels can be hidden when another application is active. Window-ID
// capture still returns their rendered content; retain this process's panels.
let windows = CGWindowListCopyWindowInfo([.optionAll, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] ?? []
for info in windows {
    guard info[kCGWindowOwnerPID as String] as? Int == Int(pid),
          let id = info[kCGWindowNumber as String] as? Int,
          let raw = info[kCGWindowBounds as String] as? [String: Any],
          let bounds = CGRect(dictionaryRepresentation: raw as CFDictionary),
          bounds.width > 100, bounds.height > 100 else { continue }
    let title = (info[kCGWindowName as String] as? String ?? "dialog").replacingOccurrences(of: "\t", with: " ")
    print("\(id)\t\(Int(bounds.width))\t\(Int(bounds.height))\t\(title)")
}
'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--scenario", action="append", help="Capture selected scenarios only")
    parser.add_argument("--theme", choices=["light", "dark"], action="append")
    parser.add_argument("--no-build", action="store_true")
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("Native CGWindowID capture requires macOS")
    if not args.no_build:
        subprocess.run(["cargo", "build", "--locked", "-p", "block-app", "--bin", "block"], cwd=ROOT, check=True)
    binary = ROOT / "target/debug/block"
    available = subprocess.check_output([binary, "--list-scenarios"], text=True).splitlines()
    scenarios = args.scenario or available
    if any(name not in available for name in scenarios):
        parser.error("Unknown scenario; use target/debug/block --list-scenarios")
    output = ROOT / "target/parity-shots/native"
    output.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="block-snap-") as directory:
        temporary = Path(directory)
        source = temporary / "windows.swift"
        source.write_text(SWIFT)
        helper = temporary / "windows"
        subprocess.run(["swiftc", source, "-o", helper], check=True)
        for name in scenarios:
            for theme in args.theme or ["light", "dark"]:
                with (temporary / "app.log").open("wb") as log:
                    app = subprocess.Popen([binary, "--scenario", name, "--theme", theme], cwd=ROOT, stdout=log, stderr=log)
                    try:
                        windows = []
                        dialog = name in {
                            "home-profile-drawer", "home-account-drawer", "home-downloads-drawer",
                            "download-files", "wizard-version-picker", "wizard-loader-picker",
                            "wizard-fabric-picker", "wizard-quilt-picker", "wizard-loader-loading",
                            "wizard-loader-error", "wizard-loader-empty",
                            "wizard-configuration", "welcome-version-picker", "remove-confirmation",
                            "remove-account-confirmation", "remove-provider-confirmation", "separate-confirmation", "games-help",
                            "welcome-settings", "welcome-about",
                        } or name.startswith("auth-")
                        required = 2 if dialog else 1
                        deadline = time.monotonic() + 12
                        last = None
                        stable = time.monotonic()
                        while time.monotonic() < deadline:
                            if app.poll() is not None:
                                raise RuntimeError(f"{name} exited before capture: {(temporary / 'app.log').read_text()}")
                            result = subprocess.run([helper, str(app.pid)], text=True, capture_output=True)
                            if result.returncode:
                                raise RuntimeError(result.stderr.strip())
                            windows = sorted([line.split("\t", 3) for line in result.stdout.splitlines()], key=lambda row: int(row[0]))
                            if windows != last:
                                last, stable = windows, time.monotonic()
                            if len(windows) >= required and time.monotonic() - stable >= 1:
                                break
                            time.sleep(0.15)
                        if len(windows) < required:
                            raise RuntimeError(f"{name} did not open its {required} expected windows")
                        for index, (window, width, height, title) in enumerate(windows):
                            purpose = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-") or "dialog"
                            suffix = "" if index == 0 else f"-{purpose}-{index}"
                            path = output / f"{name}{suffix}-{theme}.png"
                            subprocess.run(["screencapture", "-x", "-o", "-l", window, path], check=True)
                            print(f"{path.relative_to(ROOT)} ({width}×{height} logical pixels)", flush=True)
                    finally:
                        # Request normal app termination so its scenario TempDir is removed.
                        subprocess.run([helper, str(app.pid), "--terminate"], capture_output=True)
                        try:
                            app.wait(timeout=3)
                        except subprocess.TimeoutExpired:
                            app.terminate()
                            app.wait(timeout=5)
    subprocess.run([sys.executable, ROOT / "scripts/parity-board"], check=True)


if __name__ == "__main__":
    main()
