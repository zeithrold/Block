#!/usr/bin/env python3
"""Publish an Accounts candidate only after independent title/viewport/OCR checks.

Use with capture-accounts-windows.ps1 outputs downloaded to this Mac. The remote
PNG is a candidate, never an accepted image until this command succeeds.
"""
import argparse
import json
from pathlib import Path

from capture_assertions import ocr, publish, validate


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("candidate", type=Path)
    parser.add_argument("receipt", type=Path)
    parser.add_argument("destination", type=Path)
    parser.add_argument("--viewport", type=int, nargs=2, default=[1152, 720])
    args = parser.parse_args()
    receipt = json.loads(args.receipt.read_text(encoding="utf-8-sig"))
    required = receipt.pop("required_text")
    if not {"Accounts", "Account details", "Offline Mode"}.issubset(required):
        parser.error("Accounts candidates must assert the account-specific page content")
    assertions = validate(args.candidate, receipt["window"], title="Block · Accounts",
                          viewport=args.viewport, required=required, observations=ocr(args.candidate))
    publish(args.candidate, args.destination.resolve(), receipt, assertions)
    print(args.destination, "asserted")


if __name__ == "__main__":
    main()
