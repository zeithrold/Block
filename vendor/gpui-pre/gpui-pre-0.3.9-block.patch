+    /// Non-unit scales are inert until they settle at 1, retaining focus handles.
+    /// Panics if the factor is not finite and positive, or the origin is not finite.
+    fn paint_scale(mut self, factor: f32, origin: Point<f32>) -> Self {
+        assert!(
+            factor.is_finite() && factor > 0.,
+            "paint scale must be finite and positive"
