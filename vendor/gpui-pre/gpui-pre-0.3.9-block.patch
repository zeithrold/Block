+    /// Attach full AccessKit properties to the official semantic tree.
+    fn accessibility(
+        mut self,
+        node: accesskit::Node,
+        _focused: bool,
+        handler: impl FnMut(&accesskit::ActionRequest, &mut Window, &mut App) + 'static,
+    ) -> Self {
+        self.interactivity().accessibility = Some(crate::accessibility_compat::Accessibility {
+            node,
+            handler: std::rc::Rc::new(std::cell::RefCell::new(Box::new(handler))),
+        });
+        self
+    }
