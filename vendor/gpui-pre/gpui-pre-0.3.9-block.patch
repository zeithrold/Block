+        second.push_scale(
+            PaintTransform::around(0.9, point(ScaledPixels(100.), ScaledPixels(100.))),
+            mask,
+        );
+        second.replay(start..end, &first);
+        second.pop_scale();
+        let actual = second.subpixel_sprites[0].bounds;
+        assert!((actual.origin.x.0 - 19.).abs() < 0.0001);
+        assert!((actual.origin.y.0 - 28.).abs() < 0.0001);
+        assert!((actual.size.width.0 - 27.).abs() < 0.0001);
+        assert!((actual.size.height.0 - 36.).abs() < 0.0001);
+    }
