+/// A positive uniform paint transform, in device coordinates. Layout is unchanged.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct PaintTransform {
+    pub(crate) scale: f32,
+    pub(crate) offset: Point<ScaledPixels>,
+}
+
+impl Default for PaintTransform {
+    fn default() -> Self {
+        Self {
+            scale: 1.,
+            offset: Point::default(),
+        }
+    }
+}
+
+impl PaintTransform {
+    pub(crate) fn around(scale: f32, origin: Point<ScaledPixels>) -> Self {
+        Self {
+            scale,
+            offset: origin * (1. - scale),
+        }
+    }
+
+    pub(crate) fn compose(self, inner: Self) -> Self {
+        Self {
+            scale: self.scale * inner.scale,
+            offset: inner.offset * self.scale + self.offset,
+        }
+    }
+
+    pub(crate) fn point(self, value: Point<ScaledPixels>) -> Point<ScaledPixels> {
+        value * self.scale + self.offset
+    }
+
+    fn bounds(self, value: Bounds<ScaledPixels>) -> Bounds<ScaledPixels> {
+        Bounds {
+            origin: self.point(value.origin),
+            size: value.size.map(|value| value * self.scale),
+        }
+    }
+
+    pub(crate) fn mask(self, value: ContentMask<ScaledPixels>) -> ContentMask<ScaledPixels> {
+        ContentMask {
+            bounds: self.bounds(value.bounds),
+        }
+    }
+
+    fn matrix(self) -> TransformationMatrix {
+        TransformationMatrix {
+            rotation_scale: [[self.scale, 0.], [0., self.scale]],
+            translation: [self.offset.x.0, self.offset.y.0],
+        }
+    }
+
+    fn inverse(self) -> Self {
+        Self {
+            scale: 1. / self.scale,
+            offset: self.offset * (-1. / self.scale),
+        }
+    }
+}
