+    fn native_accessibility_snapshot(&self) -> Option<Vec<gpui::NativeAccessibilityNode>> {
+        // SAFETY: MacWindow owns this NSWindow and runs on the main thread.
+        // The official for_window adapter subclasses contentView, which is the
+        // parent of GPUIView; querying GPUIView would miss that provider.
+        let view = unsafe { self.0.lock().native_window.contentView() };
+        if view == nil {
+            return None;
+        }
+        // SAFETY: The live NSWindow keeps its content view alive; the state lock
+        // is released before invoking the provider, which may activate GPUI.
+        Some(unsafe { crate::native_accessibility::snapshot(view) })
+    }
