+                // SAFETY: This foreground task runs on the owning main thread;
+                // the live window owns this view, and closed windows return above.
+                // Marking it dirty requests AppKit's real displayLayer callback.
+                let view = unsafe { &*view.cast::<Objc2NSView>() };
+                view.setNeedsDisplay(true);
+            })
+            .detach();
+    }
