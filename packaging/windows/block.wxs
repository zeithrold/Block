<?xml version="1.0" encoding="utf-8"?>
<!-- WiX v4 source for the unsigned pilot MSI. Build with:
       wix build -arch <x64|arm64> \
         -d Version=<numeric version> -d Binary=<block.exe> \
         -d Icon=<Block.ico> -d License=<LICENSE> -d Notices=<THIRD_PARTY_NOTICES.txt> \
         -o Block-<version>-windows-<arch>.msi packaging/windows/block.wxs
     The MSI is deliberately unsigned; SmartScreen will warn on first run. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Block"
           Manufacturer="Block"
           Version="$(var.Version)"
           UpgradeCode="6f0e3d8a-1b2c-4f5a-9c7d-3e8b1a2f4d60"
           Scope="perMachine"
           Language="1033"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Block is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="BlockIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="BlockIcon" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Block">
        <Component Id="BlockExe" Guid="b3a1c6d2-4e5f-4a7b-8c9d-1e2f3a4b5c6d">
          <File Id="BlockExeFile" Source="$(var.Binary)" KeyPath="yes">
            <Shortcut Id="BlockStartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Block"
                      Description="Minecraft Java Edition launcher"
                      Advertise="yes" />
          </File>
        </Component>
        <Component Id="BlockLicense" Guid="c4b2d7e3-5f6a-4b8c-9d0e-2f3a4b5c6d7e">
          <File Id="BlockLicenseFile" Source="$(var.License)" KeyPath="yes" />
        </Component>
        <Component Id="BlockNotices" Guid="d5c3e8f4-6a7b-4c9d-8e1f-3a4b5c6d7e8f">
          <File Id="BlockNoticesFile" Source="$(var.Notices)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="Block" Level="1">
      <ComponentRef Id="BlockExe" />
      <ComponentRef Id="BlockLicense" />
      <ComponentRef Id="BlockNotices" />
    </Feature>
  </Package>
</Wix>
